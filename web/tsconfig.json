{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../shared/**/*.ts",
    // shared/web/ is the BROWSER half of shared/ — the seams both front doors
    // render (FormShell, formatCount, the cache store, the draft hook). It is
    // .tsx as well as .ts, and it is excluded from every worker's tsconfig,
    // which has no DOM.
    "../shared/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e/**",
    "playwright.config.ts",
    // The kit's COMPOSITIONS are reference pages built under the kit's own
    // vite tsconfig (a .png import is a string there; under Next it is a
    // StaticImageData). Neither door imports them — screens are built from
    // controls/structures — so they stay out of this program. The kit's own
    // `npm run check` typechecks them upstream.
    "../shared/ui/compositions/**"
  ]
}
