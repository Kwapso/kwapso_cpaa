# Every variable the scripts in `scripts/` read. Copy to a file you keep OUTSIDE
# the repository — the convention here is `~/.config/kwapso/keys.env` (chmod 600),
# which docs and scripts across this codebase tell you to `source`. `.env*` is gitignored,
# so a copy left here is safe, but the keys.env location is what the scripts and
# the docs assume.
#
# No value in this file is a secret. It is the LIST of which secrets exist, which
# is the part that goes missing when a machine does. INVENTORY.md § 4 says who
# issues each one.

# ── The account guard ────────────────────────────────────────────────────────
# scripts/reset-all.mjs REFUSES to run unless CLOUDFLARE_ACCOUNT_ID matches the
# id compiled into it. That guard exists because wrangler picks an account from
# whatever the machine is logged into, and no worker pins account_id.
# Needed by: reset-all.mjs, glide-to-r2.mjs, knowledge-retrieval-bench.mjs
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=          # Account → D1 → Edit (same scope as CF_D1_TOKEN)

# ── Signing in as somebody, on a non-production environment ──────────────────
# The test-login door mints a normal hashed code and hands it back once. Its
# holder can sign in as ANY account on that environment, so it is STAGING ONLY —
# the door refuses outright when the worker's ENVIRONMENT var is "production".
# Needed by: smoke-staging.mjs, smoke-mcp.mjs, seed-staging.mjs,
#            seed-knowledge-about-the-app.mjs, seed-the-quiet-screens.mjs,
#            knowledge-backfill.mjs, and the e2e suite
TEST_LOGIN_KEY=

# Maintenance endpoints (migrate-teams, db-sizes, grant-credits, the error log).
# Needed by: smoke-staging.mjs, seed-staging.mjs
ADMIN_KEY=

# ── Which deployment a script talks to ───────────────────────────────────────
# Each defaults to the staging *.workers.dev name (SMOKE_PORTAL_BASE excepted —
# see its own note). Export one to point a script somewhere else.
SMOKE_BASE=                    # smoke-staging.mjs, smoke-mcp.mjs
SMOKE_PORTAL_BASE=             # smoke-portal.mjs — the client door it proves; defaults to
                               # https://staging-client.kwapso.app, the REAL hostname (the
                               # Google sign-in door answers 400 at the workers.dev alias)
SEED_BASE=                     # seed-staging.mjs
STAGING_BASE=                  # knowledge-backfill.mjs
PRODUCTION_BASE=               # knowledge-backfill.mjs

# Who the seed and backfill scripts sign in as. An owner-level account on the
# target environment.
SEED_OWNER_EMAIL=              # seed-staging.mjs, the two seed-* scripts
BACKFILL_EMAIL=                # knowledge-backfill.mjs
KNOWLEDGE_COOKIE=              # knowledge-backfill.mjs — an existing session, if
                               # you would rather not use the test-login door

# ── The legacy Glide pull (customer data — see INVENTORY.md § 6) ─────────────
# Glide issues an API token on the Business plan and above. glide/data/ and
# glide/files/ are gitignored ON PURPOSE and must stay that way.
GLIDE_API_KEY=                 # glide-pull.mjs

# ── The retrieval benchmark (optional, local only) ───────────────────────────
# scripts/knowledge-retrieval-bench.mjs. Its corpus and cached vectors are
# hundreds of MB and land in .kb-bench/, which is gitignored and rebuildable.
KB_REPO=
KB_BOOKS=
KB_CACHE=
KB_EMBED_MODEL=
