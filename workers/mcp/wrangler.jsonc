// The MCP worker — kwapso's external machine surface (ARCHITECTURE: the MCP front
// desk). Personal access tokens (hashed, shown-once, team-pinned, revocable) are
// bridged to short-lived TEAM-PINNED sessions minted by auth, so every MCP tool
// call flows through the SAME gated doors a browser uses — a token can never
// exceed its owner's live rights, and never act outside its pinned team. Reached
// ONLY through the gateway (/mcp + /api/mcp/*); not public itself.
// Secrets (wrangler secret put): INTERNAL_KEY (the auth session-mint bridge).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwapso-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kwapso-core",
      "database_id": "e55a2c0f-346a-4056-b01c-7869a8b253dc",
      "migrations_dir": "../../db/core"
    }
  ],
  "services": [
    { "binding": "AUTH", "service": "kwapso-auth" },
    { "binding": "TENANCY", "service": "kwapso-tenancy" },
    { "binding": "CONTENT", "service": "kwapso-content" },
    { "binding": "DATAOPS", "service": "kwapso-data-ops" }
  ],
  // PER-CALLER RATE LIMIT on the machine surface (shared/workers/rate-limit.ts),
  // keyed on the TOKEN'S OWNER. Its own namespace so a looping integration is
  // refused at /mcp before it becomes several forwarded door calls. The ceiling is
  // CALLER_REQUESTS_PER_MINUTE in shared/workers/limits.ts; the code fails open if
  // this block is absent.
  "ratelimits": [
    { "name": "CALLER_LIMIT", "namespace_id": "1104", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": { "CF_ACCOUNT_ID": "b5bb3d84a59c029ea5e0fe164dab1cf7" },
  "env": {
    "staging": {
      "name": "kwapso-mcp-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kwapso-core-staging",
          "database_id": "1df02340-fc91-4cac-8ccb-d19528dcd9f7",
          "migrations_dir": "../../db/core"
        }
      ],
      "services": [
        { "binding": "AUTH", "service": "kwapso-auth-staging" },
        { "binding": "TENANCY", "service": "kwapso-tenancy-staging" },
        { "binding": "CONTENT", "service": "kwapso-content-staging" },
        { "binding": "DATAOPS", "service": "kwapso-data-ops-staging" }
      ],
      "ratelimits": [
        { "name": "CALLER_LIMIT", "namespace_id": "1104", "simple": { "limit": 600, "period": 60 } }
      ],
      "vars": { "CF_ACCOUNT_ID": "b5bb3d84a59c029ea5e0fe164dab1cf7" }
    }
  }
}
