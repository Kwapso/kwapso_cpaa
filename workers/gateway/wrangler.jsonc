// The GATEWAY worker — kwapso's public address. Top-level = PRODUCTION
// (the worker is literally named "kwapso"); staging lives under env.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwapso",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  // PRODUCTION's one public address is the custom domain, agency.kwapso.app.
  // workers_dev is OFF here so there is no SECOND address for the same door: a
  // *.workers.dev name answers before anything bound to the custom hostname
  // (rate limits, WAF rules, country rules, an Access policy), so leaving it on
  // quietly undoes whatever is configured there. It was on until 11 Aug 2026 —
  // kwapso.kwapso.workers.dev answered 200 while the docs said production had no
  // public address at all.
  //
  // preview_urls is OFF in BOTH environments for the reason OPERATIONS.md already
  // gives for the six domain workers: a per-version preview URL is another public
  // door to the same worker, and an UPLOADED-but-undeployed version is exactly the
  // code nobody has decided to ship.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../web/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Worker-first for every DYNAMIC path the worker owns. An ARRAY here means
    // non-listed paths skip the worker entirely (asset-only), so ALL must be
    // listed: /api/* (routed to the domain workers), /media/* (R2), and /t/*
    // (the deep-link shell — otherwise the asset layer 404s an unknown
    // /t/<team>/<module>/<id> navigation before the worker sees it). Static
    // screens (/, /home, /_next/static/**) are NOT listed, so they keep the
    // fast asset path + the immutable _headers caching.
    "run_worker_first": ["/api/*", "/media/*", "/t/*", "/learning/*", "/help/*", "/mcp"]
  },
  "services": [
    { "binding": "AUTH", "service": "kwapso-auth" },
    { "binding": "TENANCY", "service": "kwapso-tenancy" },
    { "binding": "REALTIME", "service": "kwapso-realtime" },
    { "binding": "CONTENT", "service": "kwapso-content" },
    { "binding": "DATAOPS", "service": "kwapso-data-ops" },
    { "binding": "MCP", "service": "kwapso-mcp" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "kwapso-media" },
    { "binding": "LEARNING_MEDIA", "bucket_name": "kwapso-learning-media" }
  ],
  "env": {
    "staging": {
      "name": "kwapso-staging",
      "observability": { "enabled": true },
      // Staging keeps its *.workers.dev name — the smoke and the seed use it, and
      // there is nothing on staging worth fencing a second address away from.
      // Said out loud because envs do NOT inherit the top-level value.
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "../../web/out",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*", "/media/*", "/t/*", "/learning/*", "/help/*", "/mcp"]
      },
      "services": [
        { "binding": "AUTH", "service": "kwapso-auth-staging" },
        { "binding": "TENANCY", "service": "kwapso-tenancy-staging" },
        { "binding": "REALTIME", "service": "kwapso-realtime-staging" },
        { "binding": "CONTENT", "service": "kwapso-content-staging" },
        { "binding": "DATAOPS", "service": "kwapso-data-ops-staging" },
        { "binding": "MCP", "service": "kwapso-mcp-staging" }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "kwapso-media-staging" },
        { "binding": "LEARNING_MEDIA", "bucket_name": "kwapso-learning-media-staging" }
      ]
    }
  }
}
