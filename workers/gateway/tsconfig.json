{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // The lifecycle suite IMPORTS scripts/r2-lifecycle.mjs rather than re-typing
    // its derivations, so that the bucket list a test checks is literally the one
    // the script applies. `allowJs` lets tsc read that file; `checkJs` stays off,
    // so the scripts folder is not suddenly type-checked by this workspace.
    "allowJs": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"],
    // `@shared/*` names what a worker imports instead of counting directory
    // levels back to it. tsc reads this; so does wrangler's esbuild. Vitest
    // does not — vitest.workers.config.ts (repo root) carries the same map.
    "paths": { "@shared/*": ["../../shared/*"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../../types/node-shims.d.ts"]
}
