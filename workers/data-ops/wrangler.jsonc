// The DATA-OPS worker — bulk data import (and, next, the AI agent brain). It writes
// through the SAME gated create endpoints the UI uses (act-as-user: it forwards the
// caller's session cookie to the content / tenancy workers), so every import respects
// the caller's permissions + each module's validation. Only the two gateways are
// public — this worker is reachable only via service bindings, which is what keeps
// the agent's act-as-user surface off the public internet. The CLIENT portal's door
// does not even bind this worker.
// Secrets (wrangler secret put): CF_D1_TOKEN (reach per-team DBs), INTERNAL_KEY
// (worker-to-worker), ADMIN_KEY (owner-only import-catalog seeding).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwapso-data-ops",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kwapso-core",
      "database_id": "e55a2c0f-346a-4056-b01c-7869a8b253dc",
      "migrations_dir": "../../db/core"
    }
  ],
  "services": [
    { "binding": "AUTH", "service": "kwapso-auth" },
    { "binding": "REALTIME", "service": "kwapso-realtime" },
    { "binding": "CONTENT", "service": "kwapso-content" },
    { "binding": "TENANCY", "service": "kwapso-tenancy" }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "CF_ACCOUNT_ID": "b5bb3d84a59c029ea5e0fe164dab1cf7",
    "AGENT_MODEL": "claude-sonnet-5",
    "AGENT_EFFORT": "low",
    "AGENT_FREE_DAILY": "50",
    "WORKERS_AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
  },
  "env": {
    "staging": {
      "name": "kwapso-data-ops-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kwapso-core-staging",
          "database_id": "1df02340-fc91-4cac-8ccb-d19528dcd9f7",
          "migrations_dir": "../../db/core"
        }
      ],
      "services": [
        { "binding": "AUTH", "service": "kwapso-auth-staging" },
        { "binding": "REALTIME", "service": "kwapso-realtime-staging" },
        { "binding": "CONTENT", "service": "kwapso-content-staging" },
        { "binding": "TENANCY", "service": "kwapso-tenancy-staging" }
      ],
      "ai": { "binding": "AI" },
      "vars": {
        "CF_ACCOUNT_ID": "b5bb3d84a59c029ea5e0fe164dab1cf7",
        "AGENT_MODEL": "claude-sonnet-5",
        "AGENT_EFFORT": "low",
        "AGENT_FREE_DAILY": "50",
        "WORKERS_AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
      }
    }
  }
}
