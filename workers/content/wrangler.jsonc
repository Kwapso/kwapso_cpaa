// The CONTENT worker — team-DB content modules (Learning today; Help next).
// Secrets (wrangler secret put): CF_D1_TOKEN (Account→D1→Edit API token) so it
// can reach per-team databases over the one REST door.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwapso-content",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Only the two gateways are public — this worker is reachable only via bindings.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kwapso-core",
      "database_id": "e55a2c0f-346a-4056-b01c-7869a8b253dc",
      "migrations_dir": "../../db/core"
    }
  ],
  "services": [
    { "binding": "AUTH", "service": "kwapso-auth" },
    { "binding": "REALTIME", "service": "kwapso-realtime" }
  ],
  "r2_buckets": [
    { "binding": "LEARNING_MEDIA", "bucket_name": "kwapso-learning-media" },
    { "binding": "HELP_MEDIA", "bucket_name": "kwapso-help-media" }
  ],
  "vars": { "CF_ACCOUNT_ID": "b5bb3d84a59c029ea5e0fe164dab1cf7", "PUBLIC_APP_URL": "https://agency.kwapso.app" },
  // No cron — content modules have no nightly housekeeping.
  "env": {
    "staging": {
      "name": "kwapso-content-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kwapso-core-staging",
          "database_id": "1df02340-fc91-4cac-8ccb-d19528dcd9f7",
          "migrations_dir": "../../db/core"
        }
      ],
      "services": [
        { "binding": "AUTH", "service": "kwapso-auth-staging" },
        { "binding": "REALTIME", "service": "kwapso-realtime-staging" }
      ],
      "r2_buckets": [
        { "binding": "LEARNING_MEDIA", "bucket_name": "kwapso-learning-media-staging" },
        { "binding": "HELP_MEDIA", "bucket_name": "kwapso-help-media-staging" }
      ],
      "vars": { "CF_ACCOUNT_ID": "b5bb3d84a59c029ea5e0fe164dab1cf7", "PUBLIC_APP_URL": "https://agency-staging.kwapso.app" }
    }
  }
}
