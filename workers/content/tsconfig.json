{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"],
    // `@shared/*` names what a worker imports instead of counting directory
    // levels back to it. tsc reads this; so does wrangler's esbuild. Vitest
    // does not — vitest.workers.config.ts (repo root) carries the same map.
    "paths": { "@shared/*": ["../../shared/*"] }
  },
  // shared/web/ is the BROWSER half of shared/ — React modules both front doors
  // render. A worker compiles with no DOM and no React, so it never sees them.
  // shared/ui/ is the vendored component library and is the same case one step
  // further: every file in it is a browser module, and the .ts logic halves that
  // sit beside the .tsx reach for document, Node and NodeFilter, none of which
  // exist in a worker. Excluded HERE rather than made DOM-agnostic, because the
  // two front doors are the only things that ever render it.
  "exclude": ["../../shared/web/**", "../../shared/ui/**"],
  "include": ["src/**/*.ts", "test/**/*.ts", "../../shared/**/*.ts", "../../types/node-shims.d.ts"]
}
