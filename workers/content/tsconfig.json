{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"]
  },
  // shared/web/ is the BROWSER half of shared/ — React modules both front doors
  // render. A worker compiles with no DOM and no React, so it never sees them.
  "exclude": ["../../shared/web/**"],
  "include": ["src/**/*.ts", "test/**/*.ts", "../../shared/**/*.ts"]
}
