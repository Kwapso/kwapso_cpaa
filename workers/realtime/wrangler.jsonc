// The REALTIME worker — kwapso's live "switchboard". Defines the TeamChannel
// Durable Object (one instance per team, addressed by name "team:<id>"), which
// holds that team's open WebSockets (hibernatable — idle teams cost ~nothing)
// and broadcasts change pings. It reads team_members (global core DB) only to
// gate connections, and asks the auth worker who's connecting. Stores NO app
// data. Top-level = PRODUCTION; staging under env (envs don't inherit, so the
// DO binding + migration + DB + service are repeated there).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwapso-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Only the two gateways are public — this worker is reachable only via service
  // bindings (each gateway forwards the /api/realtime WebSocket to it).
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "CHANNELS", "class_name": "TeamChannel" },
      { "name": "INTEREST", "class_name": "TeamInterest" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TeamChannel"] },
    { "tag": "v2", "new_sqlite_classes": ["TeamInterest"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kwapso-core",
      "database_id": "e55a2c0f-346a-4056-b01c-7869a8b253dc"
    }
  ],
  // The D1 REST door, for the one extra read a joining socket needs: is this
  // listener a CLIENT login, and which accounts are theirs (the fence). Without
  // it the team channel refuses everyone — deliberately: we cannot tell staff
  // from a client, and the channel names row ids. CF_D1_TOKEN is a secret.
  "vars": { "CF_ACCOUNT_ID": "b5bb3d84a59c029ea5e0fe164dab1cf7" },
  "services": [{ "binding": "AUTH", "service": "kwapso-auth" }],
  "env": {
    "staging": {
      "name": "kwapso-realtime-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "durable_objects": {
        "bindings": [
      { "name": "CHANNELS", "class_name": "TeamChannel" },
      { "name": "INTEREST", "class_name": "TeamInterest" }
    ]
      },
      "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TeamChannel"] },
    { "tag": "v2", "new_sqlite_classes": ["TeamInterest"] }
  ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kwapso-core-staging",
          "database_id": "1df02340-fc91-4cac-8ccb-d19528dcd9f7"
        }
      ],
      "vars": { "CF_ACCOUNT_ID": "b5bb3d84a59c029ea5e0fe164dab1cf7" },
      "services": [{ "binding": "AUTH", "service": "kwapso-auth-staging" }]
    }
  }
}
