// The AUTH worker — kwapso's front-door brain: email-code login (strict OTP — no Google, no Clerk),
// sessions. Top-level config = PRODUCTION; the staging variant is under env.
// Secrets (set via `wrangler secret put`, never in this file):
//   RESEND_API_KEY        — lets us actually send code emails
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwapso-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Only the gateway is public (locked: one public address). No *.workers.dev
  // URL for this worker — it's reachable ONLY via service bindings. BOTH flags:
  // workers_dev kills the stable subdomain, preview_urls kills the per-version
  // preview URLs (each would be a second public door).
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kwapso-core",
      "database_id": "e55a2c0f-346a-4056-b01c-7869a8b253dc",
      "migrations_dir": "../../db/core"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kwapso-media" }],
  // Auth pushes identity-level live events (account activity, profile, sign-out)
  // to a user's OWN channel through the realtime worker.
  "services": [{ "binding": "REALTIME", "service": "kwapso-realtime" }],
  "vars": {
    "APP_ORIGIN": "https://kwapso.kwapso.workers.dev",
    "EMAIL_FROM": "kwapso <alerts@kwapso.app>",
    // Ships with the deploy: the test-login door refuses outright here.
    "ENVIRONMENT": "production"
  },
  "env": {
    "staging": {
      "name": "kwapso-auth-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kwapso-core-staging",
          "database_id": "1df02340-fc91-4cac-8ccb-d19528dcd9f7",
          "migrations_dir": "../../db/core"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "kwapso-media-staging" }
      ],
      "services": [{ "binding": "REALTIME", "service": "kwapso-realtime-staging" }],
      "vars": {
        "APP_ORIGIN": "https://kwapso-staging.kwapso.workers.dev",
        "EMAIL_FROM": "kwapso <alerts@kwapso.app>",
        "ENVIRONMENT": "staging"
      }
    }
  }
}
