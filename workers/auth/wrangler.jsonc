// The AUTH worker — kwapso's front-door brain: email-code login and "Continue with
// Google" (two ways to prove ONE identity — no Clerk), sessions.
// Top-level config = PRODUCTION; the staging variant is under env.
// Secrets (set via `wrangler secret put`, never in this file):
//   RESEND_API_KEY        — lets us actually send code emails
//   GOOGLE_CLIENT_ID      — the `kwapso-signin` OAuth client id
//   GOOGLE_CLIENT_SECRET  — …and its secret. The id is not itself secret (it
//                           rides the redirect URL), but it lives beside the
//                           secret so BOTH are set by the same two commands from
//                           the same keys file, and neither is ever committed.
//                           Unset = no Google button; the code path is untouched.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwapso-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Only the two gateways are public (locked: one public address per front door —
  // the agency's and the client portal's). No *.workers.dev URL for this worker —
  // it's reachable ONLY via service bindings, which is what keeps /internal/* off
  // the public internet. BOTH flags: workers_dev kills the stable subdomain,
  // preview_urls kills the per-version preview URLs (each would be another door).
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kwapso-core",
      "database_id": "e55a2c0f-346a-4056-b01c-7869a8b253dc",
      "migrations_dir": "../../db/core"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kwapso-media" }],
  // Auth pushes identity-level live events (account activity, profile, sign-out)
  // to a user's OWN channel through the realtime worker.
  "services": [{ "binding": "REALTIME", "service": "kwapso-realtime" }],
  "vars": {
    "APP_ORIGIN": "https://agency.kwapso.app",
    // The OTHER front door. Google sign-in bounces a person back to whichever of
    // these two they came from, and to nothing else — so BOTH must be listed
    // here AND registered as redirect URIs in the Google console.
    "PORTAL_ORIGIN": "https://client.kwapso.app",
    "EMAIL_FROM": "kwapso <alerts@kwapso.app>",
    // Ships with the deploy: the test-login door refuses outright here.
    "ENVIRONMENT": "production"
  },
  "env": {
    "staging": {
      "name": "kwapso-auth-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kwapso-core-staging",
          "database_id": "1df02340-fc91-4cac-8ccb-d19528dcd9f7",
          "migrations_dir": "../../db/core"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "kwapso-media-staging" }
      ],
      "services": [{ "binding": "REALTIME", "service": "kwapso-realtime-staging" }],
      "vars": {
        "APP_ORIGIN": "https://agency-staging.kwapso.app",
        "PORTAL_ORIGIN": "https://staging-client.kwapso.app",
        "EMAIL_FROM": "kwapso <alerts@kwapso.app>",
        "ENVIRONMENT": "staging"
      }
    }
  }
}
