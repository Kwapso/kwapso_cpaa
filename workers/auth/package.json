{
  "name": "kwapso-auth",
  "version": "0.1.0",
  "private": true,
  "description": "kwapso's auth worker: email-code login, Google login, sessions. All user data in our own D1.",
  "scripts": {
    "dev": "wrangler dev --env staging --port 8787 --inspector-port 9230 --local --persist-to ../../.dev-state",
    "test": "vitest run --config ../../vitest.workers.config.ts",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
